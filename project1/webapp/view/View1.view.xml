<mvc:View controllerName="com.demo.project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    <Page id="page" title="{i18n>title}">
    <content> 
        <f:SimpleForm title="Employee Details - Simple form" editable="true"
        layout="ResponsiveGridLayout" labelSpanL="5" labelSpanM="5"
        emptySpanL="0" emptySpanM="0" columnsL="3" columnsM="3">
        <f:content>
         <core:Title text="Basic Details"></core:Title>
        <Label text="Employee Id" ></Label>
         <Input ></Input>
          <Label text="Employee Name" ></Label>
         <Input ></Input>
         <core:Title text="Other Details"></core:Title>
          <Label text="Employee City" ></Label>
         <Input ></Input>
          <Label text="Employee Skill" ></Label>
         <Input ></Input>
         <core:Title text="Contact Details"></core:Title>
          <Label text="Employee Phone" ></Label>
         <Input ></Input>
          <Label text="Employee Email" ></Label>
         <Input ></Input>
         <core:Title text="Nominee Details"></core:Title>
          <Label text="Nominee Name" ></Label>
         <Input ></Input>
          <Label text="Nominee email" ></Label>
         <Input ></Input>
        </f:content>
        
        </f:SimpleForm> 
   
    
    </content>

    
    <footer>
    <Bar id="_IDGenBar" >

    <contentRight>
    <Button id="_IDGenButton1" text="Save" type="Accept"></Button>
    <Button id="_IDGenButton2" text="Cancel" type="Reject"></Button>
    </contentRight>
   
    </Bar>
    </footer>
     </Page>
</mvc:View>